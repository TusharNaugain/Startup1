# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.
# On Railway, set these in the Project → Variables tab.

# ─── Flask ────────────────────────────────────────────────────────────────
FLASK_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ─── Database ─────────────────────────────────────────────────────────────
# Railway Postgres add-on injects DATABASE_URL automatically.
# Locally you can leave this unset — it will fall back to sqlite:///wizikey.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Admin ────────────────────────────────────────────────────────────────
# Whoever signs up with this email becomes admin (can approve payments)
ADMIN_EMAIL=naugaintushar@gmail.com

# ─── Email via Resend API (replaces SMTP — works on Vercel/serverless) ────
# Sign up free at https://resend.com — 100 emails/day free, 3000/month
# 1. Create API key at: https://resend.com/api-keys
# 2. Set MAIL_FROM to a verified sender, OR use onboarding@resend.dev for testing
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@yourdomain.com
